{
  "description": "Switch to Edit page, then import one file via File > Import > Media. filepath must be an absolute path on disk.",
  "verify_mode": "soft",
  "steps": [
    {"action": "activate_app", "name": "DaVinci Resolve", "settle_ms": 700},
    {
      "action": "click_ref",
      "element_ref": {"role": "AXCheckBox", "title_contains": "edit"}
    },
    {"action": "wait", "ms": 1000},
    {"verify": "davinci.db_snapshot", "as": "pool_before"},
    {
      "action": "menu_click",
      "script": "tell application \"System Events\"\ntell process \"DaVinci Resolve\"\nclick menu item \"Media…\" of menu \"Import\" of menu item \"Import\" of menu \"File\" of menu bar 1\nend tell\nend tell"
    },
    {"action": "wait", "ms": 2000},
    {"action": "hotkey", "combo": ["cmd", "shift", "g"]},
    {"action": "wait", "ms": 1200},
    {"action": "type", "text": "${filepath}", "interval": 0.01},
    {"action": "wait", "ms": 300},
    {"action": "hotkey", "combo": ["enter"]},
    {"action": "wait", "ms": 1200},
    {"action": "hotkey", "combo": ["enter"]},
    {"action": "wait", "ms": 1500},
    {
      "verify": "davinci.media_pool_name",
      "name": "${clip_basename}",
      "timeout": 6
    }
  ],
  "return": {"success": true, "filepath": "${filepath}"}
}
