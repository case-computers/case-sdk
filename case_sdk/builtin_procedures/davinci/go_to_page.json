{
  "description": "Switch Resolve workspace page by real-clicking the page tab (AXCheckBox). Param page: edit, cut, color, media, fusion, fairlight, deliver.",
  "verify_mode": "soft",
  "steps": [
    {"action": "activate_app", "name": "DaVinci Resolve", "settle_ms": 700},
    {
      "action": "click_ref",
      "element_ref": {
        "app": "DaVinci Resolve",
        "role": "AXCheckBox",
        "title_contains": "${page}"
      }
    },
    {"action": "wait", "ms": 1000}
  ],
  "return": {"success": true, "page": "${page}"}
}
